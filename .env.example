# Copy this file to .env.local and fill in your real values.
# .env.local is gitignored; .env.example is committed as the reference.

# Stripe API keys - get them at https://dashboard.stripe.com/test/apikeys
# Publishable key starts with pk_test_ , secret key starts with sk_test_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=REPLACE_WITH_STRIPE_PUBLISHABLE_KEY
STRIPE_SECRET_KEY=REPLACE_WITH_STRIPE_SECRET_KEY

# Absolute origin the app is served from, used to build Stripe redirect URLs.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
